# 复制为 .env 后填写，docker compose 会自动读取
# 注意：.env 已在 .gitignore 里，不要提交

# 模型服务
AGENTLOOM_LLM_PROVIDER=deepseek
AGENTLOOM_LLM_API_KEY=

# 向量化服务（法律/客服场景建议 siliconflow 的 Qwen3-Embedding）
AGENTLOOM_EMBEDDING_PROVIDER=siliconflow
AGENTLOOM_EMBEDDING_API_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_USER=agentloom
MYSQL_PASSWORD=

# Redis
REDIS_PASSWORD=

# 单机并发上限，按机器性能调整
MAX_CONCURRENT=32
